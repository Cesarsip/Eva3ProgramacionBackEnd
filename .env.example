# Copiar este archivo a .env y completar los valores.
# En AWS EC2 usar una clave secreta distinta y una contraseña de BD robusta.

DJANGO_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,IP_ELASTICA_AWS
CSRF_TRUSTED_ORIGINS=http://IP_ELASTICA_AWS,https://DOMINIO_DUCKDNS
DJANGO_USE_HTTPS=False

DB_ENGINE=django.db.backends.postgresql
DB_NAME=petcare_db
DB_USER=petcare_user
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
DB_HOST=127.0.0.1
DB_PORT=5432
